{
  "expo": {
    "name": "ledger",
    "slug": "ledger-v2",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "ledger",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "ae.sirdab.ledger",
      "supportsTablet": false,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
