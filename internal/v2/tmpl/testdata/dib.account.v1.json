{
  "id": "dib.account.v1",
  "version": 1,
  "bank": "dib",
  "normalizer_version": 1,
  "match": {
    "sender_domain": ["dib.ae"],
    "body_not_contains": ["إشعار مشتريات"]
  },
  "default_currency": "AED",
  "date_from": "body",
  "extract": [
    {
      "field": "amount",
      "type": "amount",
      "source": "body",
      "patterns": ["المبلغ\\n(?P<ccy>[A-Z]{3} )?(?P<amt>[0-9][0-9,]{0,24}\\.[0-9]{2})"]
    },
    {
      "field": "date",
      "type": "date",
      "source": "body",
      "layouts": ["DD-MM-YYYY"],
      "patterns": ["بتاريخ (?P<d>[0-9]{2}-[0-9]{2}-[0-9]{4})"]
    },
    {
      "field": "merchant",
      "type": "text",
      "source": "body",
      "patterns": ["المعاملة\\n(?P<v>[^\\n]+)"]
    },
    {
      "field": "last4",
      "type": "last4",
      "source": "body",
      "patterns": ["من حساب\\n(?P<v>[^\\n]+)"]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "credit",
      "patterns": ["إشعار إيداع"]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "debit",
      "patterns": ["إشعار خصم", "إشعار سحب"]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "debit",
      "patterns": ["من الحساب"]
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "credit"
    },
    {
      "field": "direction",
      "type": "const",
      "source": "body",
      "value": "debit",
      "patterns": ["المعاملة\\n[^\\n]*DEBIT(?:\\n|$)"],
      "override": true,
      "why": "v1 dib.go:79-83 re-derives direction from the uppercased description suffix AFTER the four-way cascade has already set it; without override the cascade's value would win and the ported template could not reproduce v1."
    },
    {
      "field": "is_transfer",
      "type": "flag",
      "source": "body",
      "value": "true",
      "flags": ["i"],
      "patterns": ["المعاملة\\n[^\\n]*(?:TRNSFER|TRANSFER)"]
    }
  ],
  "required": ["amount", "direction", "date"]
}
