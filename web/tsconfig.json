{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    // sql.js's types declare `export =` (CJS). esModuleInterop is what lets
    // `import initSqlJs from "sql.js"` type-check against that; Vite/esbuild
    // already does the runtime interop regardless, so this only affects
    // type-checking, not the emitted bundle.
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "baseUrl": ".",
    // Points at client's EMITTED `.d.ts` output (`dist-types/src/*`, built by
    // the `references` entry below), not `../client/src/*`. `platform.web.ts`
    // reaches `platform.ts` through a type-only import; if this pointed at
    // source, `tsc -b` would fully re-check that whole file — ambient `Bun`
    // global and all — even though nothing here imports its value export or
    // calls a Bun API. Consuming the declaration file instead means `Bun` is
    // already resolved (client/tsconfig.json has its own "types": ["bun"]) by
    // the time web's program sees it, so web needs no Bun ambient types of
    // its own — a stray `Bun.*` call under web/src has nothing to resolve
    // against and fails `tsc -b`, which is the whole point: see
    // client/tsconfig.json's "composite" comment and vite.config.ts's alias
    // comment for the runtime half of this constraint (Vite/Rollup bundle the
    // real source via a separate, ordinary path alias — declarations never
    // reach the bundle).
    "paths": { "@/*": ["./src/*"], "@ledger/client/*": ["../client/dist-types/src/*"] }
  },
  "include": ["src"],
  "references": [{ "path": "../client" }]
}
