{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // "bun" is needed only so `tsc -b` can fully type-check `platform.ts`,
    // which `@ledger/client/platform.web` reaches through a type-only import
    // (`import type { Platform } from "./platform"`) — TS still type-checks
    // the whole referenced file, ambient `Bun` global and all, even though
    // nothing here ever imports `platform.ts`'s VALUE export or its runtime
    // Bun API calls. This is a typecheck-only concern: `verbatimModuleSyntax`
    // erases the type-only import before bundling, so no `bun:` identifier
    // ever reaches Vite/Rollup — see vite.config.ts's alias comment for the
    // actual runtime constraint this must never violate.
    "types": ["vitest/globals", "@testing-library/jest-dom", "node", "bun"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"], "@ledger/client/*": ["../client/src/*"] }
  },
  "include": ["src"]
}
