frontend/harness/shots/

# KEPT ON PURPOSE after ledger 2.0 moved to salehtl/ledgerd on 2026-08-11. This
# path receives real bank data and a private key. The generator that wrote it
# left with v2 and the directory is absent from this checkout today, but the
# path is unchanged on this box, so the ignore stays: it costs nothing, and
# removing it is the only way this repository could ever commit that data.
spike/phase2/

# Nix build output
/result
/result-*
