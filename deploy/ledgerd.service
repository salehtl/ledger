[Unit]
Description=Ledger v2 (multi-user) — SMTP receiver, sync API, embedded PWA
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
ExecStart=/usr/local/bin/ledgerd serve -config /etc/ledger-v2/config.toml
EnvironmentFile=/etc/ledger-v2/ledgerd.env
User=ledgerd
Restart=on-failure
RestartSec=5

# :25 and :443 are both privileged. This is the ONLY capability the service
# gets, and CapabilityBoundingSet stops it acquiring any other.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# --- sandboxing (modelled on ledger.service, tightened where v2 allows) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# AF_UNIX is needed for the local Postgres socket; the DSN uses 127.0.0.1 today
# but a unix-socket DSN must not silently fail if it is ever switched.

# The autocert cache holds the ACME account key and the issued certificates —
# the whole of the service's TLS identity. StateDirectory rather than a bare
# ReadWritePaths so systemd CREATES it and ENFORCES the mode on every start:
# with ReadWritePaths alone the 0700 claim depends on whoever made the
# directory by hand, which is a comment rather than a control. Matches
# ledger.service's pattern for the same reason.
StateDirectory=ledger-v2
StateDirectoryMode=0700

# v1 is a SEPARATE service with its own database and config. Nothing here may
# reach it: /var/lib/ledger is not in ReadWritePaths, and ProtectSystem=strict
# makes the rest of the filesystem read-only.
InaccessiblePaths=/var/lib/ledger

# This box doubles as the dev machine and as the v1 production host. Cap the
# service so a leak can never starve either. Raise deliberately if the op log
# grows past what this holds.
MemoryMax=768M

[Install]
WantedBy=multi-user.target
